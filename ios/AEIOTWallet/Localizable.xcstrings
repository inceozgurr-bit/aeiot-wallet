    "Sending coins and revealing your recovery phrase always ask for %@, even when this is off.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coin gönderirken ve kurtarma cümleni görüntülerken, bu kapalı olsa bile her zaman %@ sorulur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar monedas y mostrar tu frase de recuperación siempre piden %@, incluso si esto está desactivado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Senden von Coins und beim Anzeigen deiner Wiederherstellungsphrase wird immer %@ verlangt, selbst wenn dies deaktiviert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi de pièces et l'affichage de votre phrase de récupération demandent toujours %@, même lorsque c'est désactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invio di monete e la visualizzazione della tua frase di recupero richiedono sempre %@, anche quando questa opzione è disattivata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar moedas e mostrar a frase de recuperação pedem sempre %@, mesmo com esta opção desligada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Munten versturen en je herstelzin tonen vragen altijd om %@, ook als dit uitstaat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка монет и показ фразы восстановления всегда запрашивают %@, даже если этот параметр выключен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання монет і показ фрази відновлення завжди запитують %@, навіть коли цей параметр вимкнено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال العملات والكشف عن عبارة الاسترداد يطلبان دائمًا %@، حتى عندما يكون هذا الخيار متوقفًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉइन भेजना और अपना रिकवरी फ्रेज़ दिखाना — दोनों हमेशा %@ मांगते हैं, भले ही यह ऑफ हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim koin dan menampilkan frasa pemulihan kamu selalu meminta %@, meskipun opsi ini dimatikan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งเหรียญและการแสดงวลีกู้คืนของคุณจะขอ %@ เสมอ แม้ว่าตัวเลือกนี้จะถูกปิดอยู่ก็ตาม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc gửi coin và hiển thị cụm từ khôi phục luôn yêu cầu %@, ngay cả khi tùy chọn này đang tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送代币和显示助记词始终需要 %@ 验证，即使此选项已关闭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コインの送信とリカバリーフレーズの表示は、この設定がオフの場合でも常に%@を要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인 보내기와 복구 구문 표시는 이 설정이 꺼져 있어도 항상 %@를 요구합니다."
          }
        }
      }
    },
