    "This app is asking you to sign data this wallet cannot read.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama, bu cüzdanın okuyamadığı bir veriyi imzalamanı istiyor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app te está pidiendo que firmes datos que esta billetera no puede leer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App bittet dich, Daten zu signieren, die dieses Wallet nicht lesen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app vous demande de signer des données que ce portefeuille ne peut pas lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app ti sta chiedendo di firmare dati che questo portafoglio non può leggere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app está a pedir-lhe que assine dados que esta carteira não consegue ler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app vraagt je om gegevens te ondertekenen die deze wallet niet kan lezen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение просит вас подписать данные, которые этот кошелёк не может прочитать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей застосунок просить вас підписати дані, які цей гаманець не може прочитати."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب منك هذا التطبيق توقيع بيانات لا تستطيع هذه المحفظة قراءتها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐप आपसे ऐसा डेटा साइन करने के लिए कह रहा है जिसे यह वॉलेट पढ़ नहीं सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini meminta kamu menandatangani data yang tidak bisa dibaca oleh dompet ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้กำลังขอให้คุณเซ็นข้อมูลที่วอลเล็ตนี้ไม่สามารถอ่านได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này đang yêu cầu bạn ký dữ liệu mà ví này không thể đọc được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用要求你为该钱包无法读取的数据签名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは、このウォレットが読み取れないデータへの署名を求めています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
