            "state": "translated",
            "value": "Yêu cầu này dành cho một ví khác với ví bạn đang mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求对应的钱包与你当前打开的钱包不同。"
          }
        },
