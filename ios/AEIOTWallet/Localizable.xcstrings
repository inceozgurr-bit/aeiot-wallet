    "Not enough Bitcoin to cover the amount plus the network fee.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutar ve ağ ücreti için yeterli Bitcoin yok."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente Bitcoin para cubrir el importe más la comisión de red."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Bitcoin, um den Betrag plus die Netzwerkgebühr zu decken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin insuffisant pour couvrir le montant plus les frais de réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin insufficiente per coprire l'importo più la commissione di rete."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin insuficiente para cobrir o montante mais a taxa de rede."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet genoeg Bitcoin voor het bedrag plus de netwerkkosten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно Bitcoin, чтобы покрыть сумму и комиссию сети."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо Bitcoin, щоб покрити суму та комісію мережі."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد Bitcoin كافٍ لتغطية المبلغ بالإضافة إلى رسوم الشبكة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमाउंट और नेटवर्क फीस, दोनों को कवर करने के लिए पर्याप्त Bitcoin नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin tidak cukup untuk menutup jumlah ditambah biaya jaringan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี Bitcoin ไม่เพียงพอสำหรับจำนวนเงินบวกค่าธรรมเนียมเครือข่าย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đủ Bitcoin để chi trả số lượng cộng với phí mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比特币余额不足以支付金额加网络费用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数量とネットワーク手数料を合わせるとBitcoinの残高が不足しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액과 네트워크 수수료를 합친 만큼의 비트코인이 부족합니다."
          }
        }
      }
    },
