    "Network fee is paid in %1$@ on %2$@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ ücreti %2$@ üzerinde %1$@ ile ödenir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comisión de red se paga en %1$@ en %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Netzwerkgebühr wird in %1$@ auf %2$@ bezahlt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais de réseau sont payés en %1$@ sur %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La commissione di rete viene pagata in %1$@ su %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de rede é paga em %1$@ na %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De netwerkkosten worden betaald in %1$@ op %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комиссия сети оплачивается в %1$@ в сети %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комісія мережі сплачується в %1$@ у мережі %2$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُدفع رسوم الشبكة بـ %1$@ على %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क फीस %2$@ पर %1$@ में चुकाई जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biaya jaringan dibayar dalam %1$@ di %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าธรรมเนียมเครือข่ายชำระเป็น %1$@ บน %2$@"
