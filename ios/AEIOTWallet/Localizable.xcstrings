    "Open the app in a browser, choose WalletConnect, then scan the code it shows.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı tarayıcıda aç, WalletConnect'i seç, ardından gösterdiği kodu tara."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app en un navegador, elige WalletConnect y luego escanea el código que muestra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App in einem Browser, wähle WalletConnect und scanne dann den angezeigten Code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'app dans un navigateur, choisissez WalletConnect, puis scannez le code affiché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l'app in un browser, scegli WalletConnect, poi scansiona il codice mostrato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a app num navegador, escolha WalletConnect e depois leia o código apresentado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de app in een browser, kies WalletConnect en scan dan de getoonde code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение в браузере, выберите WalletConnect, затем отсканируйте показанный код."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте застосунок у браузері, виберіть WalletConnect, а потім відскануйте показаний код."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التطبيق في متصفح، واختر WalletConnect، ثم امسح الرمز الذي يظهر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को ब्राउज़र में खोलें, WalletConnect चुनें, फिर दिखने वाला कोड स्कैन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi di browser, pilih WalletConnect, lalu pindai kode yang ditampilkan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแอปในเบราว์เซอร์ เลือก WalletConnect แล้วสแกนโค้ดที่แสดงขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở ứng dụng trong trình duyệt, chọn WalletConnect, rồi quét mã mà nó hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中打开该应用，选择 WalletConnect，然后扫描它显示的二维码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでアプリを開き、WalletConnectを選択して、表示されたコードをスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 앱을 열고 WalletConnect를 선택한 다음 표시되는 코드를 스캔하세요."
          }
