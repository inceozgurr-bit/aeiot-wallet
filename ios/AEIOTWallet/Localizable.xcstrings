    "Share this address to receive AEIOT, ETH, USDC or cbBTC on the Base network.": {
      "extractionState": "stale",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Base ağında AEIOT, ETH, USDC veya cbBTC almak için bu adresi paylaş."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte esta dirección para recibir AEIOT, ETH, USDC o cbBTC en la red Base."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile diese Adresse, um AEIOT, ETH, USDC oder cbBTC im Base-Netzwerk zu empfangen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez cette adresse pour recevoir AEIOT, ETH, USDC ou cbBTC sur le réseau Base."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi questo indirizzo per ricevere AEIOT, ETH, USDC o cbBTC sulla rete Base."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilhe este endereço para receber AEIOT, ETH, USDC ou cbBTC na rede Base."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel dit adres om AEIOT, ETH, USDC of cbBTC op het Base-netwerk te ontvangen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь этим адресом, чтобы получать AEIOT, ETH, USDC или cbBTC в сети Base."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділіться цією адресою, щоб отримувати AEIOT, ETH, USDC або cbBTC у мережі Base."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك هذا العنوان لاستلام AEIOT وETH وUSDC أو cbBTC على شبكة Base."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Base नेटवर्क पर AEIOT, ETH, USDC या cbBTC पाने के लिए यह एड्रेस शेयर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan alamat ini untuk menerima AEIOT, ETH, USDC, atau cbBTC di jaringan Base."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ที่อยู่นี้เพื่อรับ AEIOT, ETH, USDC หรือ cbBTC บนเครือข่าย Base"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ địa chỉ này để nhận AEIOT, ETH, USDC hoặc cbBTC trên mạng Base."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享此地址以在 Base 网络上接收 AEIOT、ETH、USDC 或 cbBTC。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスを共有すると、Baseネットワーク上でAEIOT、ETH、USDC、cbBTCを受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
