        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอนี้มีไว้สำหรับวอลเล็ทอื่นที่ไม่ใช่วอลเล็ทที่คุณเปิดอยู่ตอนนี้"
