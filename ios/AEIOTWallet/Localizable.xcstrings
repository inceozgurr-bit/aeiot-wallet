          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络费以 %1$@ 在 %2$@ 上支付。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク手数料は%2$@上で%1$@で支払われます。"
