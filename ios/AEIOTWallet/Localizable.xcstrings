    "Invalid Bitcoin address. It should start with bc1.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz Bitcoin adresi. bc1 ile başlamalı."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección de Bitcoin no válida. Debe empezar por bc1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige Bitcoin-Adresse. Sie sollte mit bc1 beginnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse Bitcoin invalide. Elle doit commencer par bc1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzo Bitcoin non valido. Deve iniziare con bc1."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereço Bitcoin inválido. Deve começar por bc1."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeldig Bitcoin-adres. Het moet met bc1 beginnen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный адрес Bitcoin. Он должен начинаться с bc1."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невірна адреса Bitcoin. Вона має починатися з bc1."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان Bitcoin غير صالح. يجب أن يبدأ بـ bc1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमान्य Bitcoin एड्रेस। इसकी शुरुआत bc1 से होनी चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat Bitcoin tidak valid. Alamat harus dimulai dengan bc1."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่ Bitcoin ไม่ถูกต้อง ต้องขึ้นต้นด้วย bc1"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ Bitcoin không hợp lệ. Địa chỉ phải bắt đầu bằng bc1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比特币地址无效，地址应以 bc1 开头。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なBitcoinアドレスです。アドレスはbc1で始まる必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 비트코인 주소입니다. 주소는 bc1로 시작해야 합니다."
          }
        }
      }
