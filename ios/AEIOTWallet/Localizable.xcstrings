          }
        }
      }
    },
    "Your Bitcoin address. Only send BTC on the Bitcoin network here — not cbBTC or WBTC.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin adresin. Buraya yalnızca Bitcoin ağındaki BTC gönder — cbBTC veya WBTC değil."
          }
        }
      }
    },
    "Your Recovery Phrase": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma Kelimelerin"
          }
        }
      }
    },
    "Your Solana address. It is different from the 0x… one — only send SOL or Solana tokens here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solana adresin. 0x… ile başlayan adresten farklıdır — buraya yalnızca SOL veya Solana token'ları gönder."
          }
        }
      }
    },
    "Your XRP address. The first transfer must be at least the network's account reserve, otherwise the account is not created.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "XRP adresin. İlk gönderim en az ağın hesap rezervi kadar olmalı, yoksa hesap oluşmaz."
          }
        }
      }
    },
    "Your keys, your coins. Stored only on this device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarlar senin, coinler senin. Sadece bu cihazda saklanır."
          }
        }
      }
    },
    "Your recovery phrases, wallet names and saved addresses are stored in this device's Keychain and in local app settings. They are never uploaded anywhere.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma cümlelerin, cüzdan adların ve kayıtlı adreslerin bu cihazın Keychain'inde ve yerel uygulama ayarlarında saklanır. Hiçbir yere yüklenmez."
          }
        }
      }
    },
