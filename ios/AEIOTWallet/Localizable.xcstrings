    "Check the address carefully. Transfers on the blockchain cannot be reversed.": {
      "extractionState": "stale",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresi dikkatlice kontrol et. Blockchain'deki transferler geri alınamaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la dirección con cuidado. Las transferencias en la blockchain no se pueden revertir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe die Adresse sorgfältig. Übertragungen in der Blockchain können nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l'adresse avec attention. Les transferts sur la blockchain sont irréversibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l'indirizzo con attenzione. I trasferimenti sulla blockchain non possono essere annullati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o endereço com atenção. As transferências na blockchain não podem ser revertidas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer het adres zorgvuldig. Overboekingen op de blockchain kunnen niet worden teruggedraaid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внимательно проверьте адрес. Переводы в блокчейне нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уважно перевірте адресу. Перекази в блокчейні неможливо скасувати."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من العنوان بعناية. لا يمكن التراجع عن التحويلات على البلوكتشين."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पते को ध्यान से जांचें। ब्लॉकचेन पर हुए ट्रांसफ़र वापस नहीं लिए जा सकते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa alamat dengan teliti. Transfer di blockchain tidak bisa dibatalkan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบที่อยู่อย่างละเอียด การโอนบนบล็อกเชนไม่สามารถย้อนกลับได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kiểm tra kỹ địa chỉ. Các giao dịch chuyển trên blockchain không thể đảo ngược."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请仔细核对地址。区块链上的转账无法撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスをよく確認してください。ブロックチェーン上の送金は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소를 주의 깊게 확인하세요. 블록체인 전송은 되돌릴 수 없습니다."
          }
        }
      }
    },
